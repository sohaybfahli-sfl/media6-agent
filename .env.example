# ============================================
# .env.example - Variables d'environnement
# ============================================
# Copie ce fichier en ".env" et remplis les valeurs
# Ne mets JAMAIS le .env dans Git (danger de sécurité!)

# ============================================
# RAILWAY (Cloud deployment)
# ============================================
# Ces variables sont définies automatiquement par Railway
# Mais tu peux les overrider si besoin

PORT=3000
RAILWAY_PUBLIC_DOMAIN=ton-app.railway.app
WEBHOOK_SECRET=change-this-to-something-long-and-complex-12345

# ============================================
# M365 MCP (Outlook + OneDrive)
# ============================================
# Laisse vides - le M365 MCP Client handle tout automatiquement
# Une fois que tu connectes M365 MCP dans Claude, c'est bon

M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_TENANT_ID=

# ============================================
# WECHAT (Phase 2 - Webhook)
# ============================================
# À remplir quand Sophie/Rambo configure le webhook

WECHAT_TOKEN=placeholder-change-later
WECHAT_ENCODING_AES_KEY=placeholder-change-later

# ============================================
# EMAILS (Configuration d'envoi)
# ============================================
# Adresses email pour le résumé

EMAIL_RECIPIENT=sohayb.fahli-laout@media6.com
EMAIL_SENDER=sohayb.fahli-laout@media6.com

# ============================================
# LOGGING (Débug)
# ============================================
# Définis le niveau de log

LOG_LEVEL=info
# Options: debug, info, warn, error

# ============================================
# TIMEZONE (Fuseau horaire)
# ============================================
# Pour les heures programmées (21h30, 07h30)

TZ=Europe/Zurich

# ============================================
# NOTES
# ============================================
# 1. À la 1ère exécution : BACKFILL automatique
# 2. Après : mode 24h normal
# 3. Ne mets PAS de secrets réels dans Git
# 4. Railway remplacera automatiquement via le dashboard
